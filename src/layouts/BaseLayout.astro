---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'en' | 'zh-CN';
}

const { title, description, lang = 'en' } = Astro.props;
const siteTitle = 'ht4w5';
const author = 'ht4w5';
const pageTitle = title ? `${title} - ${siteTitle}` : siteTitle;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description || 'ht4w5\'s blog'} />
  <meta name="author" content={author} />
  <link
    rel="alternate"
    type="application/rss+xml"
    title={siteTitle}
    href="/feed.xml"
  />
  <title>{pageTitle}</title>
  <script>
    // Apply stored theme immediately to avoid flash
    (function() {
      const stored = localStorage.getItem('theme');
      if (stored) {
        document.documentElement.setAttribute('data-theme', stored);
      }
    })();
  </script>
</head>
<body>
  <nav class="site-nav">
    <div class="container">
      <span class="site-title">
        <a href="/">{siteTitle}</a>
      </span>
      <ul class="nav-links">
        <li><a href="/">[posts]</a></li>
        <li><a href="/about">[about]</a></li>
        <li><a href="/tags">[tags]</a></li>
        <li><a href="/feed.xml">[feed]</a></li>
      </ul>
      <div class="search-wrapper">
        <span class="search-bracket">
          <input
            type="text"
            class="search-input"
            placeholder="search"
            aria-label="Search posts"
          />
        </span>
        <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">◐</button>
        <div class="search-results" id="search-results"></div>
      </div>
    </div>
  </nav>

  <main class="container">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      <p>© {new Date().getFullYear()} ht4w5</p>
      <p><a href="https://creativecommons.org/licenses/by-nc-sa/4.0/"><img src="/images/cc-by-nc-sa.svg" alt="CC BY-NC-SA 4.0" width="88" height="31"></a></p>
    </div>
  </footer>

  <script>
    // Theme toggle: cycles system → dark → light → system
    const LABELS: Record<string, string> = { system: 'system', dark: 'dark', light: 'light' };
    const themeToggle = document.getElementById('theme-toggle');

    function applyTheme(mode: string | null) {
      const root = document.documentElement;
      if (mode === 'dark' || mode === 'light') {
        root.setAttribute('data-theme', mode);
      } else {
        root.removeAttribute('data-theme');
      }
      if (themeToggle) {
        themeToggle.textContent = LABELS[mode ?? 'system'];
        themeToggle.setAttribute('aria-label', `Theme: ${mode ?? 'system'}`);
      }
    }

    // Init button icon from stored value
    applyTheme(localStorage.getItem('theme'));

    if (themeToggle) {
      themeToggle.addEventListener('click', () => {
        const current = localStorage.getItem('theme');
        // system (null) → dark → light → system
        const next = current === null ? 'dark' : current === 'dark' ? 'light' : null;
        if (next) {
          localStorage.setItem('theme', next);
        } else {
          localStorage.removeItem('theme');
        }
        applyTheme(next);
      });
    }

    import type Fuse from 'fuse.js';
    import type { FuseResult } from 'fuse.js';

    interface SearchItem {
      slug: string;
      title: string;
      tags: string[];
      excerpt: string;
      date: string;
    }

    let searchIndex: SearchItem[] | null = null;
    let fuse: Fuse<SearchItem> | null = null;

    const searchInput = document.querySelector<HTMLInputElement>('.search-input');
    const searchResults = document.getElementById('search-results');

    async function loadSearchIndex(): Promise<void> {
      if (searchIndex) return;

      try {
        const response = await fetch('/search-index.json');
        const data: unknown = await response.json();
        if (!Array.isArray(data)) return;
        searchIndex = data as SearchItem[];

        // Dynamically import Fuse.js
        const FuseCtor = (await import('fuse.js')).default;
        fuse = new FuseCtor(searchIndex, {
          keys: ['title', 'tags', 'excerpt'],
          threshold: 0.3,
          includeScore: true,
        });
      } catch (e) {
        console.error('Failed to load search index:', e);
      }
    }

    function showResults(results: FuseResult<SearchItem>[]): void {
      if (!searchResults) return;
      searchResults.replaceChildren();

      if (results.length === 0) {
        const empty = document.createElement('div');
        empty.className = 'search-no-results';
        empty.textContent = 'No results found.';
        searchResults.append(empty);
      } else {
        for (const { item } of results.slice(0, 10)) {
          const link = document.createElement('a');
          link.className = 'search-result-item';
          link.href = `/blog/${item.slug}`;

          const title = document.createElement('span');
          title.className = 'result-title';
          title.textContent = item.title;

          const date = document.createElement('span');
          date.className = 'result-date';
          date.textContent = item.date;

          link.append(title, date);
          searchResults.append(link);
        }
      }

      searchResults.classList.add('active');
    }

    function updateResults(): void {
      const query = searchInput?.value.trim() ?? '';

      if (!query || !fuse) {
        searchResults?.classList.remove('active');
        return;
      }

      showResults(fuse.search(query));
    }

    searchInput?.addEventListener('focus', () => {
      void loadSearchIndex().then(updateResults);
    });

    searchInput?.addEventListener('input', () => {
      if (!fuse) {
        void loadSearchIndex().then(updateResults);
        return;
      }
      updateResults();
    });

    // Close search results when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (!searchInput?.contains(target) && !searchResults?.contains(target)) {
        searchResults?.classList.remove('active');
      }
    });
  </script>
</body>
</html>
