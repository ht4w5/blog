---
import '../styles/global.css';
import FooterBadges from '../components/FooterBadges.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: 'en' | 'zh-CN';
}

const { title, description, lang = 'en' } = Astro.props;
const siteTitle = 'ht4w5';
const author = 'ht4w5';
const pageTitle = title ? `${title} - ${siteTitle}` : siteTitle;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description || 'ht4w5\'s blog'} />
  <meta name="author" content={author} />
  <link rel="icon" type="image/svg+xml" href="/favicon.png" />
  <link
    rel="alternate"
    type="application/rss+xml"
    title={siteTitle}
    href="/feed.xml"
  />
  <title>{pageTitle}</title>
  <script>
    // Apply stored theme immediately to avoid flash
    (function() {
      const stored = localStorage.getItem('theme');
      if (stored) {
        document.documentElement.setAttribute('data-theme', stored);
      }
    })();
  </script>
</head>
<body>
  <nav class="site-nav">
    <div class="container">
      <span class="site-title">
        <a href="/">{siteTitle}</a>
      </span>
      <div class="nav-group">
        <ul class="nav-links">
          <li><a href="/">[home]</a></li>
          <li><a href="/posts">[posts]</a></li>
          <li><a href="/about">[about]</a></li>
          <li><a href="/tags">[tags]</a></li>
          <li><a href="/dirs">[dirs]</a></li>
          <li><a href="/feed.xml">[feed]</a></li>
        </ul>
        <button class="theme-toggle" id="theme-toggle" aria-label="Change theme (currently system)">system</button>
      </div>
    </div>
  </nav>

  <main class="container">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      <p>© {new Date().getFullYear()} ht4w5</p>
      <FooterBadges />
    </div>
  </footer>

  <script>
    // Theme toggle: cycles system → dark → light → system
    const LABELS: Record<string, string> = { system: 'system', dark: 'dark', light: 'light' };
    const themeToggle = document.getElementById('theme-toggle');

    function applyTheme(mode: string | null) {
      const root = document.documentElement;
      if (mode === 'dark' || mode === 'light') {
        root.setAttribute('data-theme', mode);
      } else {
        root.removeAttribute('data-theme');
      }
      if (themeToggle) {
        // The visible label mirrors the current mode (the brackets are CSS);
        // the accessible name says what activating the button does.
        themeToggle.textContent = LABELS[mode ?? 'system'];
        themeToggle.setAttribute('aria-label', `Change theme (currently ${mode ?? 'system'})`);
      }
    }

    // Init the label from the stored value
    applyTheme(localStorage.getItem('theme'));

    if (themeToggle) {
      themeToggle.addEventListener('click', () => {
        const current = localStorage.getItem('theme');
        // system (null) → dark → light → system
        const next = current === null ? 'dark' : current === 'dark' ? 'light' : null;
        if (next) {
          localStorage.setItem('theme', next);
        } else {
          localStorage.removeItem('theme');
        }
        applyTheme(next);
      });
    }
  </script>
</body>
</html>
