---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  variant: 'rail' | 'inline';
}

const { headings, variant } = Astro.props;
const tocHeadings = headings
  // `footnote-label` is the generated "Footnotes" heading (screen-reader
  // only); it must not appear in the table of contents.
  .filter((h) => h.depth >= 2 && h.depth <= 3 && h.slug !== 'footnote-label')
  .map((h) => ({ ...h, text: h.text.replace(/\s*#$/, '') }));
---

{tocHeadings.length > 0 && (
  <nav class={`toc toc--${variant}`} aria-label="Table of contents">
    {/* Plain static heading: the label never toggles anything, and the
        entries are always visible in both variants — nothing to tap open. */}
    <h2 class="toc-title">Contents</h2>
    <ol class="toc-list">
      {tocHeadings.map((heading) => (
        <li class={`toc-item toc-depth-${heading.depth}`}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}

<script>
  // Scrollspy: for each table-of-contents instance on the page, highlight the
  // entry for the section currently in view and keep that entry visible inside
  // the instance's scrollable container. Driven per instance: the page may
  // render the component more than once, and each copy tracks its own state.
  interface TocEntry {
    link: HTMLAnchorElement;
    item: HTMLElement;
    heading: HTMLElement;
  }

  // A heading counts as "current" once it passes this line below the top.
  const OFFSET = 120;

  function setupScrollspy(toc: HTMLElement): () => void {
    const entries: TocEntry[] = [];
    for (const link of toc.querySelectorAll<HTMLAnchorElement>('.toc a')) {
      const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
      const item = link.closest<HTMLElement>('.toc-item');
      if (heading && item) entries.push({ link, item, heading });
    }

    let active: TocEntry | null = null;

    function keepVisible(entry: TocEntry): void {
      const top = entry.item.getBoundingClientRect().top - toc.getBoundingClientRect().top + toc.scrollTop;
      const bottom = top + entry.item.offsetHeight;
      if (top < toc.scrollTop) {
        toc.scrollTop = top;
      } else if (bottom > toc.scrollTop + toc.clientHeight) {
        toc.scrollTop = bottom - toc.clientHeight;
      }
    }

    function setActive(entry: TocEntry | null): void {
      if (entry === active) return;
      if (active) {
        active.item.classList.remove('is-active');
        active.link.removeAttribute('aria-current');
      }
      active = entry;
      if (active) {
        active.item.classList.add('is-active');
        active.link.setAttribute('aria-current', 'true');
        keepVisible(active);
      }
    }

    function update(): void {
      const marker = window.scrollY + OFFSET;
      let current: TocEntry | null = null;
      for (const entry of entries) {
        if (entry.heading.getBoundingClientRect().top + window.scrollY <= marker) {
          current = entry;
        } else {
          break;
        }
      }
      // At the very bottom, the last heading is the current one.
      if (entries.length > 0 && window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
        current = entries[entries.length - 1];
      }
      setActive(current);
    }

    return update;
  }

  const updateFns = Array.from(document.querySelectorAll<HTMLElement>('.toc'), setupScrollspy);

  function updateAll(): void {
    for (const update of updateFns) update();
  }

  window.addEventListener('scroll', updateAll, { passive: true });
  window.addEventListener('resize', updateAll);
  updateAll();
</script>
