---
// Link-to-me box: leads the button wall with this site's own 88×31 button
// beside a ready-made HTML embed snippet in the blog's code-block style. A
// Copy control puts the snippet on the clipboard and confirms inline
// ("copied!" label that reverts); where the clipboard API is unavailable or
// refuses, the snippet text is selected for manual copying instead.
import { buttons } from '../data/buttons';

const self = buttons.find((entry) => entry.href === '/');
if (!self) throw new Error('link-to-me box needs the self button entry in buttons.ts');

const site = Astro.site ?? new URL('https://ht4w5.github.io');
const pageUrl = new URL(self.href ?? '/', site).href;
const artUrl = new URL(self.imageSrc, site).href;
const snippet = `<a href="${pageUrl}"><img src="${artUrl}" width="88" height="31" alt="${self.alt}" /></a>`;
---

<div class="link-to-me">
  <img class="link-to-me-art" src={self.imageSrc} alt={self.alt} width="88" height="31" />
  <div class="link-to-me-snippet">
    <pre><code>{snippet}</code></pre>
    <!-- Revealed by the script below; hidden without JavaScript, where the
         snippet text stays selectable for manual copying. -->
    <button type="button" class="link-to-me-copy" hidden>copy</button>
  </div>
</div>

<script>
  // Small dependency-free script for the Copy control (homepage-only).
  const box = document.querySelector('.link-to-me');
  const copy = box?.querySelector('.link-to-me-copy');
  const code = box?.querySelector('.link-to-me-snippet code');
  if (copy instanceof HTMLButtonElement && code) {
    copy.hidden = false;
    copy.addEventListener('click', async () => {
      const snippet = code.textContent ?? '';
      let copied = false;
      try {
        await navigator.clipboard.writeText(snippet);
        copied = true;
      } catch {
        // Clipboard unavailable or refused — select the snippet instead.
      }
      if (copied) {
        copy.textContent = 'copied!';
        setTimeout(() => {
          copy.textContent = 'copy';
        }, 2000);
      } else {
        const range = document.createRange();
        range.selectNodeContents(code);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
      }
    });
  }
</script>
