---
// Footer badges — the paste zone.
//
// How to add a badge:
//   1. Paste its HTML on its own line between the markers below, wrapped in
//      <li>…</li>. Any free-form markup works: bare <img>, <a><img></a>, or a
//      shields.io snippet.
//   2. That's it. CSS normalizes every badge to the same height
//      (--badge-height) and wraps them row by row, so you don't need to set
//      width/height on pasted images — existing attributes are ignored.
//
// Order in this file = order in the footer (left to right, top to bottom).
---
<ul class="footer-badges">
  <!-- ===== PASTE BADGES BELOW — one <li> per badge, one per line ===== -->
  <li><a href="/"><img src="/favicon.svg" alt="favicon" /></a></li>
  <li><a href="https://creativecommons.org/licenses/by-nc-sa/4.0/"><img src="/images/cc-by-nc-sa.svg" alt="CC BY-NC-SA 4.0" /></a></li>
  <li><a href="https://xjtu.app/"><img src="/images/xjtumen.png" alt="xjtumen" /></a></li>
  <li><a href="https://github.com/ht4w5"><img src="/images/github.svg" alt="GitHub: ht4w5" /></a></li>
  <!-- ===== END BADGES ===== -->
</ul>
