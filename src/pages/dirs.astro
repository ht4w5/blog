---
import BaseLayout from '../layouts/BaseLayout.astro';
import { directoryEntries } from '../data/site-directory';
import { externalLinkAttrs } from '../utils/links';

// Destinations follow the shared external-link policy (src/utils/links.ts):
// absolute URLs open in a new tab, root-relative ones stay in the same tab.
---

<BaseLayout title="Site directories" description="Additional hosted directories.">
  <h1>Site directories</h1>
  <p>
    Additional hosted directories.
  </p>

  <!-- Site directory entries reuse the post-list look; each label is the
       entry's URL in monospace. Order comes from the data file. -->
  <ul class="post-list">
    {
      directoryEntries.map((entry) => (
        <li class="post-item">
          <h2>
            <a class="directory-url" href={entry.href} {...externalLinkAttrs(entry.href)}>{entry.href}</a>
          </h2>
          {entry.description && <p class="post-excerpt">{entry.description}</p>}
        </li>
      ))
    }
  </ul>
</BaseLayout>
