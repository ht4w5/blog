---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { generateExcerpt } from '../../utils/excerpt';
import { tagHue } from '../../utils/tag-color';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => !post.data.draft);

  // Get all unique tags
  const tags = new Set<string>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      tags.add(tag);
    }
  }

  const POSTS_PER_PAGE = 20;
  const paths: Array<{ params: { tag: string; page?: string }; props: { tag: string; posts: typeof posts; currentPage: number; totalPages: number } }> = [];

  for (const tag of tags) {
    const tagPosts = posts
      .filter((post) => post.data.tags.includes(tag))
      .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

    const totalPages = Math.ceil(tagPosts.length / POSTS_PER_PAGE);

    // First page (no page number in URL)
    paths.push({
      params: { tag },
      props: { tag, posts: tagPosts, currentPage: 1, totalPages },
    });

    // Additional pages
    for (let i = 2; i <= totalPages; i++) {
      paths.push({
        params: { tag, page: String(i) },
        props: { tag, posts: tagPosts, currentPage: i, totalPages },
      });
    }
  }

  return paths;
}

const { tag, posts, currentPage, totalPages } = Astro.props;
const POSTS_PER_PAGE = 20;
const startIndex = (currentPage - 1) * POSTS_PER_PAGE;
const paginatedPosts = posts.slice(startIndex, startIndex + POSTS_PER_PAGE);

function formatDate(dateString: string): string {
  return dateString;
}

function generatePageNumbers(current: number, total: number): (number | string)[] {
  if (total <= 7) {
    return Array.from({ length: total }, (_, i) => i + 1);
  }

  const pages: (number | string)[] = [];
  pages.push(1);

  if (current > 3) {
    pages.push('…');
  }

  for (let i = Math.max(2, current - 1); i <= Math.min(total - 1, current + 1); i++) {
    pages.push(i);
  }

  if (current < total - 2) {
    pages.push('…');
  }

  if (total > 1) {
    pages.push(total);
  }

  return pages;
}

const pageNumbers = generatePageNumbers(currentPage, totalPages);
---

<BaseLayout title={`Tag: ${tag}`} description={`Posts tagged with ${tag}`}>
  <h1>Tag: {tag}</h1>

  {paginatedPosts.length === 0 ? (
    <p>No posts tagged '{tag}'. <a href="/tags">View all tags</a></p>
  ) : (
    <>
      <ul class="post-list">
        {paginatedPosts.map((post) => {
          const excerpt = generateExcerpt(post.data.description, post.body);
          return (
            <li class="post-item">
              <h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2>
              <time class="post-date" datetime={post.data.date}>
                {formatDate(post.data.date)}
              </time>
              {post.data.tags.length > 0 && (
                <div class="tag-pills">
                  {post.data.tags.map((t) => (
                    <a href={`/tags/${t}`} class="tag-pill" style={`--hue: ${tagHue(t)}`}>{t}</a>
                  ))}
                </div>
              )}
              {excerpt && <p class="post-excerpt">{excerpt}</p>}
            </li>
          );
        })}
      </ul>

      {totalPages > 1 && (
        <nav class="pagination" aria-label="Pagination">
          {currentPage > 1 && (
            <a href={currentPage === 2 ? `/tags/${tag}` : `/tags/${tag}/page/${currentPage - 1}`} aria-label="Previous page">prev</a>
          )}

          {pageNumbers.map((page) => {
            if (page === '…') {
              return <span class="disabled">…</span>;
            }
            const pageNum = page as number;
            return pageNum === currentPage ? (
              <span class="current">{pageNum}</span>
            ) : (
              <a href={pageNum === 1 ? `/tags/${tag}` : `/tags/${tag}/page/${pageNum}`}>{pageNum}</a>
            );
          })}

          {currentPage < totalPages && (
            <a href={`/tags/${tag}/page/${currentPage + 1}`} aria-label="Next page">next</a>
          )}
        </nav>
      )}
    </>
  )}
</BaseLayout>
