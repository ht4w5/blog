---
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonWall from '../components/ButtonWall.astro';
import { getCollection } from 'astro:content';
import { generateExcerpt } from '../utils/excerpt';
import { tagHue } from '../utils/tag-color';

export async function getStaticPaths() {
  return [{ params: {} }];
}

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// The homepage is a quick current snapshot — at most the 10 most recent
// posts — with the complete list living at /posts (nav-posts-search
// ticket 03).
const RECENT_POSTS = 10;
const recentPosts = posts.slice(0, RECENT_POSTS);

function formatDate(dateString: string): string {
  return dateString;
}
---

<BaseLayout title="Home">
  <ul class="post-list">
    {recentPosts.map((post) => {
      const excerpt = generateExcerpt(post.data.description, post.body);
      return (
        <li class="post-item">
          <h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2>
          <time class="post-date" datetime={post.data.date}>
            {formatDate(post.data.date)}
          </time>
          {post.data.tags.length > 0 && (
            <div class="tag-pills">
              {post.data.tags.map((tag) => (
                <a href={`/tags/${tag}`} class="tag-pill" style={`--hue: ${tagHue(tag)}`}>{tag}</a>
              ))}
            </div>
          )}
          {excerpt && <p class="post-excerpt">{excerpt}</p>}
        </li>
      );
    })}
  </ul>

  {/* The single exit to the complete list at /posts (nav-posts-search
      ticket 03): bracket-style like the nav links, literal brackets. */}
  <p class="all-posts-link"><a href="/posts">[all posts]</a></p>

  <hr class="buttons-separator" />
  <ButtonWall />
</BaseLayout>
